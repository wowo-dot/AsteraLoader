// Windows version information for one shipped binary. CMake fills this in
// per target (al_version_resource in CMakeLists.txt); the generated copy is
// in the build tree.
#include <winver.h>

@AL_RC_ICON@

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS @AL_RC_FLAGS@
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @AL_RC_TYPE@
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Astera Loader contributors"
            VALUE "FileDescription", "@AL_RC_DESCRIPTION@"
            VALUE "FileVersion", "@AL_VERSION_LABEL@"
            VALUE "InternalName", "@AL_RC_NAME@"
            VALUE "LegalCopyright", "Copyright (c) 2026 wowodot and Astera Loader contributors. MIT licence."
            VALUE "OriginalFilename", "@AL_RC_FILENAME@"
            VALUE "ProductName", "Astera Loader"
            VALUE "ProductVersion", "@AL_VERSION_LABEL@ (@AL_GIT_COMMIT@)"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
