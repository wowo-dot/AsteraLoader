cmake_minimum_required(VERSION 3.25)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run)
set(WORK "${WORK}/${run}")
file(MAKE_DIRECTORY "${WORK}/launcher/AsteraLoader" "${WORK}/game folder")
file(COPY_FILE "${LAUNCHER}" "${WORK}/launcher/AsteraLoader.exe")
file(COPY_FILE "${CORE}" "${WORK}/launcher/AsteraLoader/AsteraLoader.dll")
file(COPY_FILE "${FAKE_GAME}" "${WORK}/game folder/MonsterHunterWorld.exe")
set(ENV{AL_FAKE_OUTPUT} "${WORK}/fake.log")
set(ENV{AL_FAKE_EXIT} 37)
execute_process(COMMAND "${WORK}/launcher/AsteraLoader.exe"
    "${WORK}/game folder/MonsterHunterWorld.exe" "a b" "" "tail\\" "a\"b" "日本語"
    WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE result TIMEOUT 30)
if(NOT result STREQUAL "37")
    message(FATAL_ERROR "Launcher returned ${result}, expected game's exit code 37")
endif()
file(READ "${WORK}/fake.log" fake)
if(NOT fake MATCHES "core_loaded_before_main=1")
    message(FATAL_ERROR "Astera Loader did not load before fake game's main: ${fake}")
endif()
file(TO_NATIVE_PATH "${WORK}/game folder" game_directory)
string(FIND "${fake}" "cwd=${game_directory}" found)
if(found EQUAL -1)
    message(FATAL_ERROR "Game has incorrect working directory: ${fake}")
endif()
foreach(argument IN ITEMS "arg=\"a b\"" "arg=\"\"" "arg=tail\\" "arg=\"a\\\"b\"" "arg=日本語")
    string(FIND "${fake}" "${argument}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Argument lost: ${argument}, output: ${fake}")
    endif()
endforeach()
file(GLOB logs "${WORK}/launcher/AsteraLoader/logs/launcher.*.log")
set(confirmed FALSE)
foreach(path IN LISTS logs)
    file(READ "${path}" content)
    if(content MATCHES "core_confirmed_before_resume" AND content MATCHES "game_exit_code=37")
        string(FIND "${content}" "game_resumed" resumed)
        string(FIND "${content}" "exe_sha256=" hashed)
        if(resumed EQUAL -1 OR hashed LESS resumed)
            message(FATAL_ERROR "EXE checksum was not logged after resume: ${content}")
        endif()
        file(SHA256 "${WORK}/game folder/MonsterHunterWorld.exe" expected_hash)
        string(FIND "${content}" "exe_sha256=${expected_hash}" found)
        if(found EQUAL -1)
            message(FATAL_ERROR "Launcher EXE checksum does not match the launched file")
        endif()
        set(confirmed TRUE)
    endif()
endforeach()
if(NOT confirmed)
    message(FATAL_ERROR "No launcher log confirmed core before resume")
endif()
file(GLOB logs "${WORK}/launcher/AsteraLoader/logs/core.*.log")
set(confirmed FALSE)
foreach(path IN LISTS logs)
    file(READ "${path}" content)
    if(content MATCHES "startup_confirmed" AND content MATCHES "dll_sha256=[0-9a-f]+")
        set(confirmed TRUE)
    endif()
endforeach()
if(NOT confirmed)
    message(FATAL_ERROR "No core startup log")
endif()
