cmake_minimum_required(VERSION 3.25)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run)
set(WORK "${WORK}/${run}")
file(MAKE_DIRECTORY "${WORK}/launcher/AsteraLoader" "${WORK}/game/AsteraLoader/plugins/frame_probe"
    "${WORK}/game/AsteraLoader/plugins/frame_reflex")
file(COPY_FILE "${LAUNCHER}" "${WORK}/launcher/AsteraLoader.exe")
file(COPY_FILE "${CORE}" "${WORK}/launcher/AsteraLoader/AsteraLoader.dll")
file(COPY_FILE "${FAKE_GAME}" "${WORK}/game/MonsterHunterWorld.exe")
file(COPY_FILE "${PROBE}" "${WORK}/game/AsteraLoader/plugins/frame_probe/frame_probe.dll")
file(COPY_FILE "${REFLEX}" "${WORK}/game/AsteraLoader/plugins/frame_reflex/frame_reflex.dll")
set(ENV{AL_FAKE_OUTPUT} "${WORK}/fake.log")
if(BACKUP)
    set(ENV{AL_FAKE_FRAME_BACKUP} 1)
else()
    unset(ENV{AL_FAKE_FRAME_BACKUP})
endif()
execute_process(COMMAND "${WORK}/launcher/AsteraLoader.exe" "${WORK}/game/MonsterHunterWorld.exe"
    WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE result TIMEOUT 30)
if(NOT result STREQUAL "37")
    message(FATAL_ERROR "Frame fake game exited ${result}; inspect ${WORK}")
endif()
file(READ "${WORK}/fake.log" fake)
file(READ "${WORK}/launcher/AsteraLoader/logs/plugins/frame_probe.log" plugin)
file(GLOB logs "${WORK}/launcher/AsteraLoader/logs/core.*.log")
list(GET logs 0 log)
file(READ "${log}" core)
if(NOT fake MATCHES "frame_valid=1 frames=3 tasks=2 exiting=1 game_ready=1" OR NOT plugin MATCHES "shutdown_frame_valid=1")
    message(FATAL_ERROR "Frame/thread/task validation failed: ${fake}; ${plugin}")
endif()
set(source "exit_site")
if(BACKUP)
    set(source "frame_backup")
endif()
string(REGEX MATCHALL "phase_exiting source=${source}" exits "${core}")
list(LENGTH exits count)
string(REGEX MATCHALL "phase_game_ready source=title frame=1 " readies "${core}")
list(LENGTH readies ready_count)
if(NOT ready_count EQUAL 1 OR NOT core MATCHES "game_ready_armed site=Area:TitleStart" OR
    NOT core MATCHES "name=Area:TitleStart state=active layers=AsteraLoader")
    message(FATAL_ERROR "GAME_READY summaries failed: ${core}")
endif()
if(NOT count EQUAL 1 OR NOT core MATCHES "frame_state=stopped frames=3" OR
    NOT core MATCHES "frame_tasks plugin=frame_probe posted=2 run=2 dropped=0" OR
    NOT core MATCHES "layers=frame_reflex,AsteraLoader,frame_probe" OR core MATCHES "warning:")
    message(FATAL_ERROR "Frame layer summaries failed: ${core}")
endif()
