cmake_minimum_required(VERSION 3.25)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run)
set(WORK "${WORK}/${run}")
file(MAKE_DIRECTORY "${WORK}/launcher/AsteraLoader" "${WORK}/game/AsteraLoader/plugins")
file(COPY_FILE "${LAUNCHER}" "${WORK}/launcher/AsteraLoader.exe")
file(COPY_FILE "${CORE}" "${WORK}/launcher/AsteraLoader/AsteraLoader.dll")
file(COPY_FILE "${FAKE_GAME}" "${WORK}/game/MonsterHunterWorld.exe")
foreach(role IN ITEMS alpha beta gamma)
    file(MAKE_DIRECTORY "${WORK}/game/AsteraLoader/plugins/hook_${role}")
    file(COPY_FILE "${PLUGIN_${role}}" "${WORK}/game/AsteraLoader/plugins/hook_${role}/hook_${role}.dll")
endforeach()
set(ENV{AL_FAKE_OUTPUT} "${WORK}/fake.log")
execute_process(COMMAND "${WORK}/launcher/AsteraLoader.exe" "${WORK}/game/MonsterHunterWorld.exe"
    WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE result TIMEOUT 30)
if(NOT result STREQUAL "37")
    message(FATAL_ERROR "Game-hook fixture exited ${result}; inspect ${WORK}")
endif()
file(READ "${WORK}/fake.log" fake)
if(NOT fake MATCHES "game_hooks_valid=1")
    message(FATAL_ERROR "Missing game-hook validation: ${fake}")
endif()
file(GLOB logs "${WORK}/launcher/AsteraLoader/logs/core.*.log")
list(GET logs 0 log)
file(READ "${log}" core)
foreach(marker IN ITEMS "game_hook_existing_patch[^\n]*module=hook_alpha.dll"
    "game_hook[^\n]*name=FixtureDamage state=active layers=hook_beta,hook_alpha"
    "phase_shutdown_enter.*game_hook[^\n]*name=FixtureDamage state=active layers=hook_beta,hook_alpha,hook_gamma"
    "phase_shutdown_enter.*game_hook[^\n]*name=FixtureLater state=active layers=hook_gamma")
    if(NOT core MATCHES "${marker}")
        message(FATAL_ERROR "Missing ${marker}: ${core}")
    endif()
endforeach()
if(core MATCHES "game_hook[^\n]*state=failed|warning:")
    message(FATAL_ERROR "Game-hook fixture reported a failure: ${core}")
endif()
file(READ "${WORK}/launcher/AsteraLoader/logs/plugins/hook_gamma.log" gamma)
if(NOT gamma MATCHES "win_main_join=active" OR NOT gamma MATCHES "internal_does_not_bypass=1")
    message(FATAL_ERROR "Late join/internal call failed: ${gamma}")
endif()
