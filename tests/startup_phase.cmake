cmake_minimum_required(VERSION 3.25)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run)
set(WORK "${WORK}/${run}")
file(MAKE_DIRECTORY "${WORK}/launcher/AsteraLoader" "${WORK}/game/AsteraLoader/plugins/pre_main_probe")
file(COPY_FILE "${LAUNCHER}" "${WORK}/launcher/AsteraLoader.exe")
file(COPY_FILE "${CORE}" "${WORK}/launcher/AsteraLoader/AsteraLoader.dll")
file(COPY_FILE "${FAKE_GAME}" "${WORK}/game/MonsterHunterWorld.exe")
file(COPY_FILE "${PLUGIN}" "${WORK}/game/AsteraLoader/plugins/pre_main_probe/pre_main_probe.dll")
set(ENV{AL_FAKE_OUTPUT} "${WORK}/fake.log")
set(ENV{AL_FAKE_EXIT} 37)
set(ENV{AL_TEST_PLUGIN_RECORD} "${WORK}/plugin.log")
# Let the diagnostic worker finish its bounded final drain on successful runs.
set(ENV{AL_FAKE_SLEEP_MS} 100)
file(SHA256 "${WORK}/game/MonsterHunterWorld.exe" cache_hash)
set(cache_file "${WORK}/launcher/AsteraLoader/cache/scan.${cache_hash}.txt")
if(CACHE_SEED)
    file(MAKE_DIRECTORY "${WORK}/launcher/AsteraLoader/cache")
    file(COPY_FILE "${CACHE_SEED}" "${cache_file}")
endif()
if(EXPECT_SIGNATURE_SOURCE)
    set(ENV{AL_FAKE_CACHE_LOG_FOLDER} "${WORK}/launcher/AsteraLoader/logs")
endif()
if(EXPECT_TRUNCATION)
    set(ENV{AL_FAKE_TRACE_OVERFLOW} 1)
endif()
if(EXPECT_HELPER)
    set(ENV{AL_FAKE_HELPER_TRANSITION} 1)
endif()
if(EXPECT_SKIP)
    set(ENV{AL_FAKE_SKIP_TRANSITION} 1)
    set(ENV{AL_FAKE_SLEEP_MS} 16000)
endif()
execute_process(COMMAND "${WORK}/launcher/AsteraLoader.exe" "${WORK}/game/MonsterHunterWorld.exe"
    WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE result TIMEOUT 30)
if(NOT result STREQUAL "37")
    message(FATAL_ERROR "Phase launcher returned ${result}, expected game exit 37")
endif()
file(READ "${WORK}/fake.log" fake)
foreach(marker IN ITEMS "security_cookie_unchanged=1" "common_main_unchanged=1" "crt_wrapper_restored=1")
    if(NOT fake MATCHES "${marker}")
        message(FATAL_ERROR "Startup invariant lost: ${marker}; ${fake}")
    endif()
endforeach()
string(REGEX MATCH "main_thread_id=([0-9]+)" thread "${fake}")
set(thread_id "${CMAKE_MATCH_1}")
file(GLOB logs "${WORK}/launcher/AsteraLoader/logs/core.*.log")
list(LENGTH logs count)
if(NOT count EQUAL 1)
    message(FATAL_ERROR "Expected exactly one core log")
endif()
list(GET logs 0 path)
file(READ "${path}" core)
if(EXPECT_SIGNATURE_SOURCE AND NOT core MATCHES "startup_signature_source=${EXPECT_SIGNATURE_SOURCE}")
    message(FATAL_ERROR "Expected ${EXPECT_SIGNATURE_SOURCE} signature path: ${core}")
endif()
if(EXPECT_CACHE_REJECT AND NOT core MATCHES "startup_signature_cache_rejected:")
    message(FATAL_ERROR "Invalid cached RVA was not rejected: ${core}")
endif()
foreach(marker IN ITEMS "[qpc=" "bootstrap_us=" "bootstrap_stage=dll_hash_begin"
                        "bootstrap_stage=observer_hook_created" "bootstrap_stage=bootstrap_complete"
                        "startup_vprotect_call" "caller_location=[MonsterHunterWorld.exe section=.bind"
                        "old=unavailable result=0" "startup_vprotect_summary")
    string(FIND "${core}" "${marker}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Missing diagnostic marker ${marker}: ${core}")
    endif()
endforeach()
if(CACHE_RESULT)
    if(NOT EXISTS "${cache_file}")
        message(FATAL_ERROR "Verified full scan did not write its cache: ${core}")
    endif()
    file(COPY_FILE "${cache_file}" "${CACHE_RESULT}")
endif()
if(EXPECT_SKIP OR EXPECT_TRUNCATION)
    string(REGEX MATCHALL "startup_vprotect_call index=" records "${core}")
    list(LENGTH records recorded)
    if(NOT recorded EQUAL 256 OR NOT core MATCHES "recorded=256 limit=256 truncated=[1-9][0-9]* pending=0")
        message(FATAL_ERROR "Trace cap or summary failed: ${core}")
    endif()
endif()
if(EXPECT_SKIP)
    if(EXISTS "${WORK}/plugin.log" OR core MATCHES "phase_pre_main_enter" OR
       NOT core MATCHES "phase_pre_main_skipped: no verified post-unpack startup transition" OR
       NOT core MATCHES "startup_api_observer_removed")
        message(FATAL_ERROR "Missing transition did not skip cleanly: ${core}")
    endif()
    return()
endif()
file(READ "${WORK}/plugin.log" plugin)
set(expected "pre_main_probe init\npre_main_probe phase 0\npre_main_probe phase_thread ${thread_id}\nstartup-state-preserved\n")
if(NOT plugin STREQUAL expected)
    message(FATAL_ERROR "PRE_MAIN was not delivered once on the main thread: ${plugin}")
endif()
file(SHA256 "${WORK}/game/MonsterHunterWorld.exe" expected_hash)
string(FIND "${core}" "plugin_exe_sha256=${expected_hash}" hash_found)
if(hash_found EQUAL -1)
    message(FATAL_ERROR "Plugin host did not receive the background EXE hash: ${core}")
endif()
if(NOT EXPECT_TRUNCATION)
    if(EXPECT_HELPER)
        set(transition_origin 0)
    else()
        set(transition_origin 1)
    endif()
    foreach(marker IN ITEMS "from_bind=${transition_origin} covers_text=1 executable_read=0"
                            "from_bind=${transition_origin} covers_text=1 executable_read=1")
        string(FIND "${core}" "${marker}" found)
        if(found EQUAL -1)
            message(FATAL_ERROR "Missing transition call detail ${marker}: ${core}")
        endif()
    endforeach()
endif()
foreach(marker IN ITEMS "unpacked_crt_verified_after_protection_change" "phase_pre_main_complete"
                        "startup_hook_timing operation=startup_restore_batch"
                        "startup_signature_scan_us="
                        "startup_api_observer_removed"
                        "plugin name=pre_main_probe version=0.0.1 status=active")
    string(FIND "${core}" "${marker}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Missing core marker ${marker}: ${core}")
    endif()
endforeach()
