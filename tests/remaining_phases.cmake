cmake_minimum_required(VERSION 3.25)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run)
set(WORK "${WORK}/${run}")
file(MAKE_DIRECTORY "${WORK}/launcher/cmfm" "${WORK}/game/cmfm/plugins/phase_probe")
file(COPY_FILE "${LAUNCHER}" "${WORK}/launcher/cmfm_launcher.exe")
file(COPY_FILE "${CORE}" "${WORK}/launcher/cmfm/cmfm.dll")
file(COPY_FILE "${FAKE_GAME}" "${WORK}/game/MonsterHunterWorld.exe")
file(COPY_FILE "${PLUGIN}" "${WORK}/game/cmfm/plugins/phase_probe/phase_probe.dll")
set(ENV{CMFM_FAKE_OUTPUT} "${WORK}/fake.log")
set(ENV{CMFM_TEST_PLUGIN_RECORD} "${WORK}/plugin.log")
if(DEVICE_THREAD)
    set(ENV{CMFM_FAKE_DEVICE_THREAD} 1)
else()
    unset(ENV{CMFM_FAKE_DEVICE_THREAD})
endif()
execute_process(COMMAND "${WORK}/launcher/cmfm_launcher.exe" "${WORK}/game/MonsterHunterWorld.exe"
    WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE result TIMEOUT 30)
if(NOT result STREQUAL "37")
    message(FATAL_ERROR "Remaining-phase game exited ${result}; inspect ${WORK}")
endif()
file(READ "${WORK}/fake.log" fake)
file(READ "${WORK}/plugin.log" plugin)
string(REGEX MATCH "main_thread_id=([0-9]+)" thread "${fake}")
set(thread_id "${CMAKE_MATCH_1}")
string(REGEX MATCH "device_thread_id=([0-9]+)" thread "${fake}")
set(device_thread "${CMAKE_MATCH_1}")
if(DEVICE_THREAD AND device_thread STREQUAL thread_id)
    message(FATAL_ERROR "Setup thread fixture did not run separately")
endif()
foreach(phase IN ITEMS 0 1 2 6)
    set(expected_thread "${thread_id}")
    if(phase EQUAL 2)
        set(expected_thread "${device_thread}")
    endif()
    string(REGEX MATCHALL "phase=${phase} valid=1 thread=${expected_thread}" hits "${plugin}")
    list(LENGTH hits count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Phase ${phase} not delivered once with valid payload: ${plugin}")
    endif()
endforeach()
if(NOT plugin MATCHES "phase=0.*phase=1.*phase=2.*phase=6" OR plugin MATCHES "valid=0" OR
    NOT plugin MATCHES "spl_on_win_main_after_cmfm=1")
    message(FATAL_ERROR "Phase order/payload failed: ${plugin}")
endif()
string(REGEX MATCH "device=([0-9]+)" expected_device "${fake}")
if(NOT plugin MATCHES "${expected_device}" OR NOT fake MATCHES "warp_device_and_caller_checks=1")
    message(FATAL_ERROR "Device identity, preserved caller/code or last-error failed: ${fake}; ${plugin}")
endif()
file(GLOB logs "${WORK}/launcher/cmfm/logs/core.*.log")
list(GET logs 0 log)
file(READ "${log}" core)
foreach(marker IN ITEMS "phase_win_main_observer_removed" "phase_device_import_restored" "phase_shutdown_complete")
    if(NOT core MATCHES "${marker}")
        message(FATAL_ERROR "Missing ${marker}: ${core}")
    endif()
endforeach()
if(core MATCHES "phase_win_main_skipped|phase_device_created_skipped|warning:")
    message(FATAL_ERROR "Phase observer failed: ${core}")
endif()
