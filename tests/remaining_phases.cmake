cmake_minimum_required(VERSION 3.25)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run)
set(WORK "${WORK}/${run}")
file(MAKE_DIRECTORY "${WORK}/launcher/AsteraLoader" "${WORK}/game/AsteraLoader/plugins/phase_probe")
file(COPY_FILE "${LAUNCHER}" "${WORK}/launcher/AsteraLoader.exe")
file(COPY_FILE "${CORE}" "${WORK}/launcher/AsteraLoader/AsteraLoader.dll")
file(COPY_FILE "${FAKE_GAME}" "${WORK}/game/MonsterHunterWorld.exe")
file(COPY_FILE "${PLUGIN}" "${WORK}/game/AsteraLoader/plugins/phase_probe/phase_probe.dll")
set(ENV{AL_FAKE_OUTPUT} "${WORK}/fake.log")
set(ENV{AL_TEST_PLUGIN_RECORD} "${WORK}/plugin.log")
if(DEVICE_THREAD)
    set(ENV{AL_FAKE_DEVICE_THREAD} 1)
else()
    unset(ENV{AL_FAKE_DEVICE_THREAD})
endif()
execute_process(COMMAND "${WORK}/launcher/AsteraLoader.exe" "${WORK}/game/MonsterHunterWorld.exe"
    WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE result TIMEOUT 30)
if(NOT result STREQUAL "37")
    message(FATAL_ERROR "Remaining-phase game exited ${result}; inspect ${WORK}")
endif()
file(READ "${WORK}/fake.log" fake)
file(READ "${WORK}/plugin.log" plugin)
string(REGEX MATCH "main_thread_id=([0-9]+)" thread "${fake}")
set(thread_id "${CMAKE_MATCH_1}")
string(REGEX MATCH "device_thread_id=([0-9]+)" thread "${fake}")
set(device_thread "${CMAKE_MATCH_1}")
if(DEVICE_THREAD AND device_thread STREQUAL thread_id)
    message(FATAL_ERROR "Setup thread fixture did not run separately")
endif()
foreach(phase IN ITEMS 0 1 2 6)
    set(expected_thread "${thread_id}")
    if(phase EQUAL 2)
        set(expected_thread "${device_thread}")
    endif()
    string(REGEX MATCHALL "phase=${phase} valid=1 thread=${expected_thread}" hits "${plugin}")
    list(LENGTH hits count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Phase ${phase} not delivered once with valid payload: ${plugin}")
    endif()
endforeach()
if(NOT plugin MATCHES "phase=0.*phase=1.*phase=2.*phase=6" OR plugin MATCHES "valid=0" OR
    NOT plugin MATCHES "spl_on_win_main_after_al=1")
    message(FATAL_ERROR "Phase order/payload failed: ${plugin}")
endif()
string(REGEX MATCH "device=([0-9]+)" expected_device "${fake}")
if(NOT plugin MATCHES "${expected_device}" OR NOT fake MATCHES "warp_device_and_caller_checks=1")
    message(FATAL_ERROR "Device identity, preserved caller/code or last-error failed: ${fake}; ${plugin}")
endif()
file(GLOB logs "${WORK}/launcher/AsteraLoader/logs/core.*.log")
list(GET logs 0 log)
file(READ "${log}" core)
foreach(marker IN ITEMS "phase_win_main_observer_removed" "phase_device_import_restored" "phase_shutdown_complete")
    if(NOT core MATCHES "${marker}")
        message(FATAL_ERROR "Missing ${marker}: ${core}")
    endif()
endforeach()
if(core MATCHES "phase_win_main_skipped|phase_device_created_skipped|warning:")
    message(FATAL_ERROR "Phase observer failed: ${core}")
endif()
string(REGEX MATCHALL "phase_device_call_enter thread_id=" entries "${core}")
list(LENGTH entries entry_count)
if(NOT entry_count EQUAL 3 OR core MATCHES "phase_device_call_enter[^\n]*call=4")
    message(FATAL_ERROR "Device entry diagnostics must stop after three calls: ${core}")
endif()
foreach(call IN ITEMS 1 2 3)
    string(REGEX MATCH "phase_device_call_enter thread_id=([0-9]+) call=${call} entry_qpc=([0-9]+)" marker "${core}")
    set(call_thread "${CMAKE_MATCH_1}")
    set(entered "${CMAKE_MATCH_2}")
    string(REGEX MATCH "startup_hook_timing operation=device_return_arm elapsed_us=([0-9]+) thread_id=${call_thread} call=${call} armed=1 begin_qpc=([0-9]+) end_qpc=([0-9]+)" marker "${core}")
    set(arm_begin "${CMAKE_MATCH_2}")
    set(arm_end "${CMAKE_MATCH_3}")
    string(REGEX MATCH "phase_device_call_forward thread_id=${call_thread} call=${call} observed=1 entry_qpc=${entered} forward_log_begin_qpc=([0-9]+)" marker "${core}")
    set(forward_log "${CMAKE_MATCH_1}")
    string(REGEX MATCH "phase_device_call_return thread_id=${call_thread} call=${call} return_qpc=([0-9]+) forward_ready_qpc=([0-9]+)" marker "${core}")
    set(returned "${CMAKE_MATCH_1}")
    set(forward_ready "${CMAKE_MATCH_2}")
    string(REGEX MATCH "device_api_call_enter call=${call} entry_qpc=([0-9]+) thread=${call_thread}" marker "${plugin}")
    set(api_entry "${CMAKE_MATCH_1}")
    if(NOT entered OR NOT arm_begin OR NOT arm_end OR NOT forward_log OR NOT forward_ready OR NOT returned OR NOT api_entry OR
        entered GREATER arm_begin OR arm_begin GREATER arm_end OR arm_end GREATER forward_log OR
        forward_log GREATER forward_ready OR forward_ready GREATER api_entry OR api_entry GREATER returned)
        message(FATAL_ERROR "Call ${call} timing does not bracket arming/forwarding/API execution correctly")
    endif()
endforeach()
foreach(field IN ITEMS reset_us signal_us worker_wake_us thread_open_us suspend_us get_context_us reserve_us
                       set_context_us resume_us caller_wake_us worker_create_us worker_start_from_create_us
                       return_bridge_us diagnostic_log_us forward_log_us)
    if(NOT core MATCHES "${field}=[0-9]+")
        message(FATAL_ERROR "Missing observer step measurement ${field}")
    endif()
endforeach()
if(NOT core MATCHES "startup_hook_timing operation=win_main_arm" OR NOT core MATCHES "worker_precreated=1")
    message(FATAL_ERROR "Pre-created worker's WinMain arm was not measured")
endif()
