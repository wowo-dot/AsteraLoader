cmake_minimum_required(VERSION 3.25)
# The Steam app id the game starts with (plan_steam in launch_plan.hpp), for a
# manual install started directly: no argument, the game next to the launcher.
# Without an inherited id, the outcome depends on whether Steam runs on this
# machine; the test says which one it checked.
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run)
set(WORK "${WORK}/${run}")
set(ENV{AL_FAKE_EXIT} 37)

# Starts a fresh install in ${WORK}/${name}; sets `launcher_log` and `game_log`
# (empty if the game never ran).
function(launch name expected_result)
    set(game "${WORK}/${name}")
    file(MAKE_DIRECTORY "${game}/AsteraLoader")
    file(COPY_FILE "${LAUNCHER}" "${game}/AsteraLoader.exe")
    file(COPY_FILE "${CORE}" "${game}/AsteraLoader/AsteraLoader.dll")
    file(COPY_FILE "${FAKE_GAME}" "${game}/MonsterHunterWorld.exe")
    set(ENV{AL_FAKE_OUTPUT} "${WORK}/${name}.log")
    execute_process(COMMAND "${game}/AsteraLoader.exe"
        WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE result TIMEOUT 30)
    if(NOT result STREQUAL "${expected_result}")
        message(FATAL_ERROR "${name}: launcher returned ${result}, expected ${expected_result}")
    endif()
    file(GLOB logs "${game}/AsteraLoader/logs/launcher.*.log")
    list(LENGTH logs count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one launcher log, found ${count}")
    endif()
    file(READ "${logs}" content)
    set(launcher_log "${content}" PARENT_SCOPE)
    set(content "")
    if(EXISTS "${WORK}/${name}.log")
        file(READ "${WORK}/${name}.log" content)
    endif()
    set(game_log "${content}" PARENT_SCOPE)
endfunction()

# Steam or MO2 gave the launcher an app id: the game gets that one.
set(ENV{SteamAppId} 4242)
launch(inherited 37)
if(NOT game_log MATCHES "steam_app_id=4242[\r\n]")
    message(FATAL_ERROR "inherited: the game did not get the inherited app id: ${game_log}")
endif()
if(NOT launcher_log MATCHES "steam_app_id=4242 source=inherited")
    message(FATAL_ERROR "inherited: not logged: ${launcher_log}")
endif()

# Started directly, with no app id.
unset(ENV{SteamAppId})
execute_process(COMMAND tasklist /FI "IMAGENAME eq steam.exe" /NH
    OUTPUT_VARIABLE tasks ERROR_QUIET RESULT_VARIABLE listed)
if(NOT listed EQUAL 0)
    message(FATAL_ERROR "tasklist failed: ${listed}")
endif()
string(TOLOWER "${tasks}" tasks)
if(tasks MATCHES "steam\\.exe")
    message(STATUS "Steam runs: checking that the launcher gives the game MHW's app id")
    launch(direct 37)
    if(NOT game_log MATCHES "steam_app_id=582010[\r\n]")
        message(FATAL_ERROR "direct: the game did not get MHW's app id: ${game_log}")
    endif()
    if(NOT launcher_log MATCHES "steam_app_id=582010 source=launcher")
        message(FATAL_ERROR "direct: not logged: ${launcher_log}")
    endif()
else()
    message(STATUS "Steam does not run: checking that the launcher says so and starts nothing")
    launch(direct 1)
    if(NOT game_log STREQUAL "")
        message(FATAL_ERROR "direct: the game started without Steam: ${game_log}")
    endif()
    if(NOT launcher_log MATCHES "Steam is not running")
        message(FATAL_ERROR "direct: no explanation: ${launcher_log}")
    endif()
endif()
