cmake_minimum_required(VERSION 3.25)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run)
set(WORK "${WORK}/${run}")
file(MAKE_DIRECTORY "${WORK}/launcher/AsteraLoader" "${WORK}/game/AsteraLoader/plugins/graphics_owner" "${WORK}/game/AsteraLoader/plugins/graphics_probe")
file(COPY_FILE "${LAUNCHER}" "${WORK}/launcher/AsteraLoader.exe")
file(COPY_FILE "${CORE}" "${WORK}/launcher/AsteraLoader/AsteraLoader.dll")
file(COPY_FILE "${FAKE_GAME}" "${WORK}/game/MonsterHunterWorld.exe")
file(COPY_FILE "${OWNER}" "${WORK}/game/AsteraLoader/plugins/graphics_owner/graphics_owner.dll")
file(COPY_FILE "${PROBE}" "${WORK}/game/AsteraLoader/plugins/graphics_probe/graphics_probe.dll")
set(ENV{AL_FAKE_OUTPUT} "${WORK}/fake.log")
execute_process(COMMAND "${WORK}/launcher/AsteraLoader.exe" "${WORK}/game/MonsterHunterWorld.exe"
    WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE result TIMEOUT 30)
if(NOT result STREQUAL "37")
    message(FATAL_ERROR "Graphics fake game exited ${result}; inspect ${WORK}")
endif()
file(READ "${WORK}/fake.log" fake)
if(NOT fake MATCHES "graphics_valid=1")
    message(FATAL_ERROR "Missing graphics validation: ${fake}")
endif()
file(GLOB logs "${WORK}/launcher/AsteraLoader/logs/core.*.log")
list(GET logs 0 log)
file(READ "${log}" core)
foreach(family IN ITEMS 1 2 3 4 5)
    if(NOT core MATCHES "d3d12_install family=${family} targets=[1-9]")
        message(FATAL_ERROR "Family ${family} not installed: ${core}")
    endif()
endforeach()
foreach(marker IN ITEMS "d3d12_existing_patch[^\n]*module=graphics_owner.dll"
    "phase_shutdown_enter.*d3d12_state=running presentation_owner=graphics_owner frames=4"
    "d3d12_chain[^\n]*layers=graphics_probe,graphics_owner installed=yes"
    "d3d12_event plugin=graphics_probe event=pre_present[^\n]*calls=4"
    "d3d12_event plugin=graphics_probe event=post_resize[^\n]*calls=2")
    if(NOT core MATCHES "${marker}")
        message(FATAL_ERROR "Missing ${marker}: ${core}")
    endif()
endforeach()
if(core MATCHES "d3d12_state=unavailable|warning:")
    message(FATAL_ERROR "Graphics fixture reported a failure: ${core}")
endif()
