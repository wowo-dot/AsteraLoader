cmake_minimum_required(VERSION 3.25)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run)
set(WORK "${WORK}/${run}")
file(MAKE_DIRECTORY "${WORK}/launcher/AsteraLoader" "${WORK}/game")
file(COPY_FILE "${LAUNCHER}" "${WORK}/launcher/AsteraLoader.exe")
file(COPY_FILE "${CORE}" "${WORK}/launcher/AsteraLoader/AsteraLoader.dll")
file(COPY_FILE "${FAKE_GAME}" "${WORK}/game/MonsterHunterWorld.exe")
set(ENV{AL_FAKE_OUTPUT} "${WORK}/fake.log")
set(ENV{AL_FAKE_EXIT} 37)
if(EXPECT_EXE_HASH_FAILURE)
    set(ENV{AL_FAKE_SLEEP_MS} 500)
endif()
execute_process(COMMAND "${WORK}/launcher/AsteraLoader.exe" "${WORK}/game/MonsterHunterWorld.exe"
    WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE result TIMEOUT 30)
if(NOT result STREQUAL "${EXPECT_RESULT}")
    message(FATAL_ERROR "Launcher returned ${result}, expected ${EXPECT_RESULT}")
endif()
file(GLOB logs "${WORK}/launcher/AsteraLoader/logs/launcher.*.log")
list(LENGTH logs count)
if(NOT count EQUAL 1)
    message(FATAL_ERROR "Expected one launcher log, got ${count}")
endif()
list(GET logs 0 path)
file(READ "${path}" launcher_log)
if(EXPECT_RESULT STREQUAL "1")
    if(EXISTS "${WORK}/fake.log" OR NOT launcher_log MATCHES "suspended_child_terminated" OR
       launcher_log MATCHES "game_resumed")
        message(FATAL_ERROR "Timed-out child was not stopped before main: ${launcher_log}")
    endif()
else()
    file(READ "${WORK}/fake.log" fake)
    if(NOT fake MATCHES "core_loaded_before_main=${EXPECT_CORE}" OR
       NOT launcher_log MATCHES "core_not_confirmed_before_resume" OR
       NOT launcher_log MATCHES "game_resumed" OR NOT launcher_log MATCHES "game_exit_code=37")
        message(FATAL_ERROR "Game did not continue after Astera Loader failure: ${launcher_log}; ${fake}")
    endif()
    if(EXPECT_EXE_HASH_FAILURE)
        string(FIND "${launcher_log}" "game_resumed" resumed)
        string(FIND "${launcher_log}" "warning: exe SHA-256 unavailable; game continues" warning)
        string(FIND "${launcher_log}" "game_exit_code=37" exited)
        if(resumed EQUAL -1 OR warning LESS resumed OR exited LESS warning)
            message(FATAL_ERROR "Hash failure did not warn and keep waiting after resume: ${launcher_log}")
        endif()
    endif()
endif()
