cmake_minimum_required(VERSION 3.25)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run)
set(WORK "${WORK}/${run}")
file(MAKE_DIRECTORY "${WORK}")
set(seed "${WORK}/seed.txt")
function(launch_case name expected)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DLAUNCHER=${LAUNCHER}" "-DCORE=${CORE}"
        "-DFAKE_GAME=${FAKE_GAME}" "-DPLUGIN=${PLUGIN}" "-DWORK=${WORK}/${name}"
        "-DEXPECT_SIGNATURE_SOURCE=${expected}" "-DCACHE_SEED=${case_seed}"
        "-DCACHE_RESULT=${seed}" "-DEXPECT_CACHE_REJECT=${reject}" -DEXPECT_HELPER=1
        -P "${CMAKE_CURRENT_LIST_DIR}/startup_phase.cmake" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Startup cache case ${name} failed")
    endif()
endfunction()
launch_case(cold scan)
file(READ "${seed}" cold)
if(NOT cold MATCHES "startup crt-entry-1 [0-9a-f]+")
    message(FATAL_ERROR "Cold scan cache missing")
endif()
set(case_seed "${seed}")
launch_case(warm cache)
file(READ "${seed}" warm)
if(NOT cold STREQUAL warm)
    message(FATAL_ERROR "Warm hit should not append another CRT answer")
endif()
file(WRITE "${seed}" "startup crt-entry-1 ffffffff\n")
set(reject 1)
launch_case(out_of_bounds scan)
file(WRITE "${seed}" "startup crt-entry-1 1000\n")
launch_case(stale scan)
set(reject 0)
file(WRITE "${seed}" "startup crt-entry-0 40\nstartup crt-entry-1 fffffffff\n")
launch_case(version_or_malformed scan)
